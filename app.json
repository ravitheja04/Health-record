{
  "expo": {
    "name": "Family Health Registry",
    "slug": "family-health-registry",
    "scheme": "familyhealth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healthrecord.familyregistry",
      "infoPlist": {
        "LSSupportsOpeningDocumentsInPlace": false,
        "UIFileSharingEnabled": false
      }
    },
    "android": {
      "package": "com.healthrecord.familyregistry",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Family Health Registry to attach photos of medical reports and prescriptions.",
          "cameraPermission": "Allow Family Health Registry to photograph medical reports and prescriptions."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Family Health Registry to use Face ID to keep your family’s health records locked."
        }
      ]
    ]
  }
}
